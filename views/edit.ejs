<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Book</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="form-page">
        <h1>Edit Book</h1>

        <form action="/books/<%= book.id %>/edit" method="POST">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" value="<%= book.title %>" required>

            <label for="author">Author</label>
            <input type="text" id="author" name="author" value="<%= book.author %>" required>

            <label for="isbn">ISBN</label>
            <input type="text" id="isbn" name="isbn" value="<%= book.isbn %>">

            <label for="rating">Rating</label>
            <input type="number" id="rating" name="rating" min="1" max="5" step="0.5" value="<%= book.rating %>">

            <label for="date_read">Date Read</label>
            <input type="date" id="date_read" name="date_read"
                value="<%= book.date_read.toISOString().split('T')[0] %>">

            <label for="notes">Notes</label>
            <ul id="notes-editor" class="notes-editor" contenteditable="true">
                <% book.notes.split('\n').forEach(line=> { %>
                    <li>
                        <%= line %>
                    </li>
                    <% }) %>
            </ul>
            <textarea name="notes" id="notes" style="display: none;"></textarea>

            <button type="submit">Update Book</button>
        </form>

        <a href="/" class="back-link">← Back to my books</a>
    </div>

    <script>
        const editor = document.getElementById('notes-editor');
        const hiddenInput = document.getElementById('notes');
        const form = editor.closest('form');

        form.addEventListener('submit', () => {
            const points = [...editor.querySelectorAll('li')]
                .map(li => li.innerText.trim())
                .filter(text => text.length > 0);
            hiddenInput.value = points.join('\n');
        });
    </script>
</body>

</html>